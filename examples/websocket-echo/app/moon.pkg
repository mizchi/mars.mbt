supported_targets = "js+native"

import {
  "mizchi/mars",
  "mizchi/x/http",
  "mizchi/x/websocket",
  "moonbitlang/async",
}

warnings = "-0020-0029-0067"

pkgtype(kind: "executable")

options(
  targets: {
    "main.mbt": [ "native" ],
    "main_js.mbt": [ "js" ],
    "server_js.mbt": [ "js" ],
    "server_native.mbt": [ "native" ],
    "websocket_test.mbt": [ "native" ],
  },
)
